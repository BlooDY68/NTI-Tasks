        },
        {
          "name": "Admin Delete / Cancel Order",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":id"]
            }
