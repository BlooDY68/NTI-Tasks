        },
        {
          "name": "Customer Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
