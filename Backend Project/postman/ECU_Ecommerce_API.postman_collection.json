{
  "info": {
    "_postman_id": "ecu-ecommerce-api-collection-2026-strict",
    "name": "ECU Summer 2026 Final Project - E-Commerce API (Strict Sessions 1-12)",
    "description": "Postman collection covering Auth, Users, Categories, Products, Cart, and Orders strictly following Sessions 1-12 curriculum concepts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminUserId",
      "value": "INSERT_ADMIN_USER_ID_HERE",
      "type": "string"
    },
    {
      "key": "customerUserId",
      "value": "INSERT_CUSTOMER_USER_ID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Admin\",\n  \"email\": \"admin@ecu.edu\",\n  \"password\": \"admin12345\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Customer User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer\",\n  \"email\": \"john@ecu.edu\",\n  \"password\": \"customer12345\",\n  \"role\": \"Customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecu.edu\",\n  \"password\": \"admin12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@ecu.edu\",\n  \"password\": \"customer12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "USERS",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Admin Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Admin Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"]
            }
          }
        },
        {
          "name": "Admin Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:id/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id", "role"]
            }
          }
        },
        {
          "name": "Admin Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "CATEGORIES",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get Category By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"]
            }
          }
        },
        {
          "name": "Admin Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Gadgets, smartphones, and computers\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Admin Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Consumer Electronics\",\n  \"description\": \"Updated category description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"]
            }
          }
        },
        {
          "name": "Admin Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "PRODUCTS",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"]
            }
          }
        },
        {
          "name": "Admin Create Product (With Image)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Wireless Headphones", "type": "text" },
                { "key": "description", "value": "High fidelity audio headphones", "type": "text" },
                { "key": "price", "value": "199.99", "type": "text" },
                { "key": "category", "value": "INSERT_CATEGORY_ID_HERE", "type": "text" },
                { "key": "brand", "value": "SoundMaster", "type": "text" },
                { "key": "stock", "value": "50", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Admin Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 179.99,\n  \"stock\": 65\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"]
            }
          }
        },
        {
          "name": "Admin Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{adminUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "CART",
      "item": [
        {
          "name": "Customer Get Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "Customer Add Item To Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"INSERT_PRODUCT_ID_HERE\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items"]
            }
          }
        },
        {
          "name": "Customer Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items/:productId",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", ":productId"]
            }
          }
        },
        {
          "name": "Customer Remove Item From Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/:productId",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", ":productId"]
            }
          }
        },
        {
          "name": "Customer Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-user-id", "value": "{{customerUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        }
      ]
    },
    {
      "name": "ORDERS",
